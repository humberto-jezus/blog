# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional Azure App Service production settings (set in Azure Configuration > Environment variables):
# BLOG_ADMIN_EMAIL="humbertojezus@gmail.com"
# BLOG_ADMIN_PASSWORD="your-strong-production-password"
# BLOG_SESSION_SECRET="your-random-session-secret"
# BLOG_DATA_DIR="/home/site/blog-data"
# Optional Zero-Trust Azure Blob Storage via Managed Identity (no Storage Account Keys needed):
# AZURE_STORAGE_ACCOUNT_URL="https://<your-storage-account>.blob.core.windows.net"
# AZURE_STORAGE_CONTAINER="blog-data"
# AZURE_CLIENT_ID="<user-assigned-managed-identity-client-id>"
# Optional: Azure AI Translator (Free F0 tier = 2M chars/month) for article translation without Gemini:
# AZURE_TRANSLATOR_KEY=""
# AZURE_TRANSLATOR_REGION="brazilsouth"
